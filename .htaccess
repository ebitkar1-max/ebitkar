# ابتكار للحلول الذكية — ebitkar.com

# ── إجبار HTTPS ──────────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── ضغط الملفات ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript image/svg+xml
</IfModule>

# ── مدة التخزين المؤقت ───────────────────────────────────────
# الصور مدتها طويلة، أما CSS/JS فيراجعهما المتصفح في كل زيارة
# حتى تظهر أي تعديلات فوراً بدل انتظار انتهاء مدة التخزين
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png       "access plus 1 year"
  ExpiresByType image/svg+xml   "access plus 1 year"
  ExpiresByType image/jpeg      "access plus 1 year"
  ExpiresByType text/css        "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/html       "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # يراجع الخادم في كل مرة ويحمّل فقط لو اتغيّر فعلاً (304)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── الترميز ──────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── منع عرض محتويات المجلدات ─────────────────────────────────
Options -Indexes

# ── حجب ملفات التطوير التي ينسخها Git إلى public_html ────────
<FilesMatch "^(server\.js|build-artifact\.js|README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 /\.claude
